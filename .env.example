# Copy to .env. Never commit the result (rule 34).

# Postgres 16+. Without it the app falls back to the SQLite dev DSN.
DATABASE_URL=postgres://localhost:5432/builder_dev?sslmode=disable

# 32 bytes. Generate with: openssl rand -base64 32
# Required — a missing key is fatal at boot, not at first secret read.
BUILDER_VAULT_KEY=

# Seeded administrator. There is no default password by design.
BUILDER_ADMIN_EMAIL=
# BUILDER_ADMIN_PASSWORD=   # prefer piping on stdin

# Agent execution. `local` runs Claude Code inside the app process with full
# shell access and is refused outside local development by the boot guard.
BUILDER_EXEC=local
# BUILDER_CLAUDE_BIN=claude
# BUILDER_PERMISSION_MODE=acceptEdits

# Disable providers by short name: vault,brain,notify,issues,fleet,orchestrator
# BUILDER_DISABLE=
