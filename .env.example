# Copy to .env. Never commit the result (rule 34).

# Postgres 16+. Without it the app falls back to the SQLite dev DSN.
DATABASE_URL=postgres://localhost:5432/builder_dev?sslmode=disable

# 32 bytes. Generate with: openssl rand -base64 32
# Required — a missing key is fatal at boot, not at first secret read.
BUILDER_VAULT_KEY=

# Seeded administrator. There is no default password by design.
BUILDER_ADMIN_EMAIL=
# BUILDER_ADMIN_PASSWORD=   # prefer piping on stdin

# Agent execution. `local` runs Claude Code inside the app process with full
# shell access and is refused outside local development by the boot guard.
BUILDER_EXEC=local
# BUILDER_CLAUDE_BIN=claude
# BUILDER_PERMISSION_MODE=acceptEdits

# Disable providers by short name: vault,brain,notify,issues,fleet,orchestrator
# BUILDER_DISABLE=

# Semantic recall. Unset, the brain uses a hashed bag of words: recall is
# keyword overlap, not meaning. Set this and it becomes real. Probed at boot —
# an endpoint that does not answer falls back to keyword recall and logs why.
# A bare origin works; /v1/embeddings is appended.
# BUILDER_EMBED_URL=https://think.example.com/v1/embeddings
# BUILDER_EMBED_MODEL=bge-m3      # must be 1024-wide, see db/migrations/0002
# BUILDER_EMBED_KEY=
# BUILDER_EMBED_BACKFILL=off      # skip re-embedding older memories at boot

# Reranking. Defaults to <embed origin>/rerank; set explicitly when the two
# models are separate services. This is where the quality gain lands.
# BUILDER_RERANK_URL=http://tei-rerank:80/rerank
# BUILDER_RERANK_CANDIDATES=50
# BUILDER_RERANK_MIN_SCORE=       # no floor by default; the scale is model-specific
# BUILDER_RERANK_OFF=
