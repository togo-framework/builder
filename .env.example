# ---------------------------------------------------------------------------
# GENERATED FILE — do not edit by hand.
#
# Produced from internal/setup/capabilities.go, which is the single place an
# environment variable is declared. Editing this file directly will be
# reverted by the next generate, and CI fails if the two disagree.
#
# To add a variable: declare a Capability. That one declaration produces the
# setup step, this line, the docs row and the preflight probe.
# ---------------------------------------------------------------------------


# ===========================================================================
# CORE
# ===========================================================================

# Database URL — Postgres connection string. Everything the builder
# remembers — issues, runs, the brain, the vault — lives here.
# DATABASE_URL=

# Listen address — Host:port the API binds. Note `togo serve` ignores this
# and always binds :8080.
ADDR=:8080

# Environment — Controls MORE than it looks: it gates the terminal AND
# widens the feedback widget's CORS origins. Never set it to development on
# a real server to unlock something — use that capability's own switch.
# one of: production | development | local | test
APP_ENV=production

# Disable the builder — Turns the whole plugin off without uninstalling
# it. The kill switch.
# BUILDER_DISABLE=

# Default locale — Language the dashboard and the widget open in. Arabic
# renders right-to-left throughout.
# one of: en | ar
BUILDER_LOCALE=en

# Working directory — Repository root the agents read and write. Defaults
# to the process working directory.
# BUILDER_WORKDIR=

# Vault encryption key — Envelope key for stored secrets. Lose it and
# every stored credential is unreadable; leak it and they are all readable.
# BUILDER_VAULT_KEY=


# ===========================================================================
# AGENTS
# ===========================================================================

# Run agents — Lets the fleet claim issues and run Claude Code. With the
# local executor an agent runs INSIDE this process, inheriting DATABASE_URL
# and the vault key, holding a Bash tool. Off unless you mean it.
#
# DANGEROUS. Read the line above again before setting this.
# BUILDER_RUNNER=

# Where agents execute — Only `local` is implemented. Setting anything
# else currently changes nothing — the probe below reports that honestly
# rather than letting you believe you sandboxed something.
#
# DANGEROUS. Read the line above again before setting this.
# one of: local | coder
BUILDER_EXEC=local

# Claude Code binary — Path to the claude executable the runner spawns.
BUILDER_CLAUDE_BIN=claude

# Agent permission mode — How much a run may do unattended. Never
# bypassPermissions — that is not offered here on purpose.
# one of: acceptEdits | default
BUILDER_PERMISSION_MODE=acceptEdits

# Daily fleet budget (USD) — Ceiling across every agent in a rolling 24h.
# Hitting it aborts and reports — it never quietly downgrades to a cheaper
# model.
BUILDER_DAILY_BUDGET_USD=10

# Triage model — Model used to label and route incoming issues.
BUILDER_TRIAGE_MODEL=claude-haiku-4-5-20251001

# Preflight model — Model used by the setup wizard's connectivity check.
# BUILDER_PREFLIGHT_MODEL=

# Open pull requests — Whether a finished run opens a PR. Off means the
# work stays on a branch for you to look at.
# BUILDER_OPEN_PR=

# PR base branch — Branch pull requests target.
BUILDER_PR_BASE=main

# PR remote — Git remote pushed to.
BUILDER_PR_REMOTE=origin

# Verify command — Run after a change to decide whether it holds — your
# test or build command.
# BUILDER_VERIFY_CMD=

# Worktree root — Where per-run git worktrees are created, so a run never
# edits your checkout.
# BUILDER_WORKTREE_ROOT=

# Attachable runs (tmux) — Every run gets a tmux session you can attach to
# and watch.
BUILDER_TMUX=1

# Keep sessions after exit (s) — Seconds a finished run's tmux session
# survives, for reading the tail.
# BUILDER_TMUX_LINGER=

# Target app — Which hosted app this daemon acts on.
# BUILDER_TARGET=

# Target apps — Comma-separated apps a single builderd hosts, each
# reporting as itself.
# BUILDER_TARGETS=

# Admin email — Seeded administrator account.
# BUILDER_ADMIN_EMAIL=

# Admin password — Seeded administrator password. Change it after first
# sign-in.
# BUILDER_ADMIN_PASSWORD=


# ===========================================================================
# BRAIN
# ===========================================================================

# Embedding endpoint — Service that turns text into vectors for recall.
# BUILDER_EMBED_URL=

# Embedding API key — Credential for the embedding endpoint.
# BUILDER_EMBED_KEY=

# Embedding dimensions — Vector width. Changing it after data exists
# invalidates every stored embedding — they cannot be compared across
# widths.
# BUILDER_EMBED_DIM=

# Backfill embeddings — Re-embed existing rows in the background.
# BUILDER_EMBED_BACKFILL=

# Backfill rate — Rows per second, to keep a backfill from starving live
# traffic.
# BUILDER_EMBED_BACKFILL_RATE=

# Recall distance cutoff — Beyond this vector distance a match is
# discarded as unrelated.
# BUILDER_RECALL_MAX_DISTANCE=

# Disable reranking — Skip the rerank pass and return vector order
# directly.
# BUILDER_RERANK_OFF=

# Rerank endpoint — Service that reorders recall candidates by relevance.
# BUILDER_RERANK_URL=

# Rerank API key — Credential for the rerank endpoint.
# BUILDER_RERANK_KEY=

# Rerank model — Model used for reranking.
# BUILDER_RERANK_MODEL=

# Rerank candidates — How many vector hits are handed to the reranker.
# BUILDER_RERANK_CANDIDATES=

# Rerank score floor — Results scoring below this are dropped.
# BUILDER_RERANK_MIN_SCORE=


# ===========================================================================
# CONNECTIONS
# ===========================================================================

# Upload directory — Where screenshots and attachments are written.
# BUILDER_UPLOAD_DIR=

# Custom apps directory — Scanned for app.json manifests at boot.
# BUILDER_APPS_DIR=

# Skills directory — Where generated agent skills are written.
# BUILDER_SKILLS_DIR=


# ===========================================================================
# SDK
# ===========================================================================

# Widget theme — Visual preset for the feedback widget and its windows. A
# theme is data — a preset swaps design tokens, so this takes effect
# without a rebuild.
# one of: default | plex
BUILDER_SDK_THEME=default

# Rewrite reports with AI — Adds an "Improve this" button to the report
# composer that rewrites the reporter's text for clarity. Off by default
# because every press costs a model call; the endpoint is authenticated, so
# anonymous reporters can still file but cannot spend.
# one of: 0 | 1
BUILDER_ENHANCER=0

# Allowed widget origins — Comma-separated sites permitted to post
# feedback. Anything not listed is refused, so add every domain the widget
# is embedded on.
# BUILDER_FEEDBACK_ORIGINS=

# SDK source directory — Serve the widget from disk instead of the
# embedded bundle. For developing the widget itself.
# BUILDER_SDK_DIR=

# Dashboard source directory — Serve the dashboard from disk instead of
# the embedded build.
# BUILDER_WEB_DIR=


# ===========================================================================
# DANGER
#
# Each of these hands out real capability over this host. They default off,
# they require an explicit acknowledgement off localhost, and none of them
# should be set because a guide told you to unlock something else.
# ===========================================================================

# Terminal — Gives ANYONE who can reach the dashboard a shell on this
# host. There is no narrower version of this.
#
# DANGEROUS. Read the line above again before setting this.
# BUILDER_TERMINAL=

# Allow the terminal on a real server — Required alongside the terminal
# switch off localhost. It exists so nobody has to set APP_ENV=development
# to get a shell — that also widens CORS, and a guard you can only satisfy
# by lying teaches lying.
#
# DANGEROUS. Read the line above again before setting this.
# BUILDER_TERMINAL_ALLOW_PRODUCTION=

# Live Claude responder — Answers public chat in-process with a model.
# Same class of exposure as the runner and it faces the open internet.
#
# DANGEROUS. Read the line above again before setting this.
# BUILDER_LIVE_CLAUDE=

