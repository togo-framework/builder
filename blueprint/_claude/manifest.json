    { "path": ".claude/hook-config.json", "owner": "wizard", "contains": "binaries, migration runner, deploy commands, protected DBs, IaC paths" },
    { "path": ".claude/forbidden-imports.json", "owner": "wizard", "contains": "the import boundary table driving Rules 11/12 and post-commit-check" }
  ],

  "markerFiles": [
    {
      "path": "CLAUDE.md",
      "blocks": [
        { "marker": "builder:baseline", "owner": "blueprint", "regenerate": true },
        { "marker": "builder:generated", "owner": "fleet-builder", "regenerate": true },
        { "marker": "builder:operator", "owner": "operator", "regenerate": false }
      ]
    },
    {
      "path": ".claude/hooks/README.md",
      "blocks": [
        { "marker": "builder:baseline", "owner": "blueprint", "regenerate": true },
        { "marker": "builder:operator", "owner": "operator", "regenerate": false }
      ]
    }
  ],

