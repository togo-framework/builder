# Build output
/togo-builder
/dist/
*.test

# Local environment — never committed (rule 34)
.env
.env.*
!.env.example

# Agent run artifacts
.runs/
.plans/
.requests/

# Local Claude Code state
.claude/settings.local.json

# OS
.DS_Store

# The daemon's local workspace: it points at sibling checkouts on this machine
# and must not be what resolves modules for anyone else.
builderd/go.work
builderd/go.work.sum

# Frontend installs. web/dist IS committed — go:embed needs it in the module,
# exactly as sdk/dist is — but the tree that produced it is not.
node_modules/
# ...and the LINK web/prepare.mjs drops into the blueprint so the shared source
# resolves from its real location. A symlink, not a directory, so the pattern
# above does not match it. It is generated on every build and belongs to this
# machine; committing it would ship a dangling link into every scaffold.
blueprint/_project/web/node_modules
